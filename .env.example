DATABASE_URL="postgresql://user:password@localhost:5432/loktantra"

# ─── AUTHENTICATION ────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth — create at console.cloud.google.com
# Omit to disable Google sign-in
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password"
REDIS_URL="redis://localhost:6379"
ANTHROPIC_API_KEY=""

# ─── SEMANTIC SEARCH ──────────────────────────────────────────
# ElasticSearch 8.x — required for hybrid BM25+KNN search
# Omit to fall back to Fuse.js (constitution domain only)
ELASTICSEARCH_URL="http://localhost:9200"
# Optional: for Elastic Cloud or protected clusters
# ELASTICSEARCH_API_KEY="your-elastic-api-key"

# Voyage AI — required for vector embeddings (voyage-3, 1024-dim)
# Free tier: 200M tokens/month — https://dash.voyageai.com
# Omit to fall back to lexical-only BM25 search
VOYAGE_API_KEY=""

# Protect the POST /api/search/index endpoint in production
# Leave empty in dev (open), set a strong secret in production
SEARCH_INDEX_SECRET=""

# ─── OBSERVABILITY ────────────────────────────────────────────
# Structured log level: debug | info | warn | error (default: info)
LOG_LEVEL="info"

NEXT_PUBLIC_MAPLIBRE_STYLE="https://demotiles.maplibre.org/style.json"

# ─── MEDIA STORAGE ────────────────────────────────────────────
# Provider: "local" (dev) | "r2" (Cloudflare R2) | "s3" (AWS S3)
STORAGE_PROVIDER="local"
STORAGE_BUCKET="loktantra-media"

# Cloudflare R2 (S3-compatible, zero egress fees — recommended for production)
# STORAGE_PROVIDER="r2"
# STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# STORAGE_ACCESS_KEY="your-r2-access-key-id"
# STORAGE_SECRET_KEY="your-r2-secret-access-key"
# STORAGE_REGION="auto"
# STORAGE_CDN_DOMAIN="media.loktantra.in"    # Custom CDN domain in front of R2

# AWS S3 (alternative)
# STORAGE_PROVIDER="s3"
# STORAGE_REGION="ap-south-1"
# STORAGE_ACCESS_KEY="your-aws-access-key-id"
# STORAGE_SECRET_KEY="your-aws-secret-access-key"
# STORAGE_CDN_DOMAIN="cdn.loktantra.in"
