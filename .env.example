DATABASE_URL="postgresql://user:password@localhost:5432/loktantra"
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password"
REDIS_URL="redis://localhost:6379"
ANTHROPIC_API_KEY=""
NEXT_PUBLIC_MAPLIBRE_STYLE="https://demotiles.maplibre.org/style.json"

# ─── MEDIA STORAGE ────────────────────────────────────────────
# Provider: "local" (dev) | "r2" (Cloudflare R2) | "s3" (AWS S3)
STORAGE_PROVIDER="local"
STORAGE_BUCKET="loktantra-media"

# Cloudflare R2 (S3-compatible, zero egress fees — recommended for production)
# STORAGE_PROVIDER="r2"
# STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# STORAGE_ACCESS_KEY="your-r2-access-key-id"
# STORAGE_SECRET_KEY="your-r2-secret-access-key"
# STORAGE_REGION="auto"
# STORAGE_CDN_DOMAIN="media.loktantra.in"    # Custom CDN domain in front of R2

# AWS S3 (alternative)
# STORAGE_PROVIDER="s3"
# STORAGE_REGION="ap-south-1"
# STORAGE_ACCESS_KEY="your-aws-access-key-id"
# STORAGE_SECRET_KEY="your-aws-secret-access-key"
# STORAGE_CDN_DOMAIN="cdn.loktantra.in"
