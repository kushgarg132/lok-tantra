generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────

enum UserRole {
  USER
  RESEARCHER
  MODERATOR
  ADMIN
}

enum FlagReason {
  INACCURATE
  POLITICALLY_BIASED
  MISLEADING
  MISSING_SOURCE
  OUTDATED
  INAPPROPRIATE
  OTHER
}

enum FlagStatus {
  PENDING
  REVIEWING
  RESOLVED_VALID
  RESOLVED_INVALID
  ESCALATED
}

// ─── AUTH (NextAuth / Auth.js) ───────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // bcryptjs hash — null for OAuth-only users
  role          UserRole  @default(USER)
  accounts      Account[]
  sessions      Session[]
  flags         ContentFlag[]
  auditLogs     AuditLog[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
  @@index([role])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─── MODERATION ───────────────────────────────────────────────

model ContentFlag {
  id          String     @id @default(cuid())
  contentType String     // "ai-response" | "article" | "representative" | "search-result"
  contentId   String     // ID or hash of flagged content
  reason      FlagReason
  details     String?
  status      FlagStatus @default(PENDING)
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  reviewedBy  String?
  reviewNote  String?
  ipAddress   String?
  contentSnippet String? // First 500 chars of flagged content (for review)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([contentType, contentId])
  @@index([status, createdAt])
  @@index([userId])
  @@index([reviewedBy])
}

// ─── AUDIT ────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  action     String   // e.g., "auth.signin", "admin.update", "flag.create"
  resource   String?  // resource type (e.g., "User", "ContentFlag")
  resourceId String?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress  String?
  userAgent  String?
  payload    Json?    // sanitized request context
  result     String   // "success" | "failure" | "blocked"
  reason     String?  // why blocked/failed
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
  @@index([userId, createdAt])
  @@index([resource, resourceId])
  @@index([result, createdAt])
}

// ─── MEDIA ASSETS ───────────────────────────────────────────

model MediaAsset {
  id            String    @id @default(cuid())
  entityType    String    // "person" | "party" | "institution" | "ministry" | "court" | "constituency"
  entityId      String
  mediaType     String    // "profile" | "thumbnail" | "logo" | "banner" | "map" | "portrait" | "symbol"

  storageKey    String
  publicUrl     String?
  localPath     String?

  width         Int?
  height        Int?
  format        String?
  fileSize      Int?
  checksum      String?

  variants      Json?     // { thumb, avatar, card, original } — all CDN URLs

  sourceUrl     String?
  sourceDomain  String?
  sourceTrust   String?   // "official_govt" | "official_party" | "official_institution" | "trusted_fallback"

  isVerified    Boolean   @default(false)
  isActive      Boolean   @default(true)

  fetchedAt     DateTime?
  verifiedAt    DateTime?
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([entityType, entityId, mediaType])
  @@index([entityType, entityId])
  @@index([checksum])
  @@index([isActive, entityType])
}

// ─── AUDIT, PROVENANCE & EVENT SOURCING [NEW] ───────────────

model DataSource {
  id            String   @id @default(cuid())
  name          String   @unique
  url           String
  lastFetchedAt DateTime?
  status        String   @default("active")
  fetchCount    Int      @default(0)
  provenance    DataProvenance[]
}

model DataProvenance {
  id            String     @id @default(cuid())
  entityType    String
  entityId      String
  sourceId      String
  source        DataSource @relation(fields: [sourceId], references: [id])
  fetchedAt     DateTime
  confidence    Float      @default(1.0)
  verificationStatus String @default("PENDING") // [NEW] PENDING, VERIFIED, REJECTED
  version       Int        @default(1)
  rawData       Json?
  createdAt     DateTime   @default(now())

  @@index([entityType, entityId])
  @@index([sourceId])
}

model EntityEvent {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  eventType   String
  payload     Json
  source      String
  timestamp   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([timestamp])
}

// ─── CONSTITUTIONAL ENTITIES ─────────────────────────────────

model ConstitutionPart {
  id                   String                @id @default(cuid())
  number               Float                 @unique
  name                 String
  articles             String
  constitutionArticles ConstitutionArticle[]
}

model ConstitutionArticle {
  id              String           @id @default(cuid())
  number          String           @unique
  title           String
  text            String
  explanation     String?
  partId          String
  part            ConstitutionPart @relation(fields: [partId], references: [id])
  category        String
  isRepealed      Boolean          @default(false)
  insertedByAmend Int?
  relatedArticles String[]
  amendments      Amendment[]      @relation("ArticleAmendments")
  cases           LandmarkCase[]   @relation("ArticleCases")
  validFrom       DateTime?        // [NEW] Temporal
  validTo         DateTime?        // [NEW] Temporal
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([category])
  @@index([partId])
}

model Amendment {
  id               String                @id @default(cuid())
  number           Int                   @unique
  year             Int
  dateEnacted      DateTime?
  description      String
  fullText         String?
  significance     String
  articlesAffected ConstitutionArticle[] @relation("ArticleAmendments")
  createdAt        DateTime              @default(now())
}

model Schedule {
  id          String @id @default(cuid())
  number      Int    @unique
  title       String
  description String
  content     String
}

// ─── INSTITUTIONAL ENTITIES ──────────────────────────────────

model Institution {
  id                  String        @id @default(cuid())
  slug                String        @unique
  name                String        @unique
  type                String
  branch              String
  level               String
  parentId            String?
  parent              Institution?  @relation("InstitutionTree", fields: [parentId], references: [id])
  children            Institution[] @relation("InstitutionTree")
  constitutionalBasis String?
  description         String
  powers              String[]
  website             String?
  logoUrl             String?
  mediaUpdatedAt      DateTime?
  established         String?
  establishedOn       DateTime?     // [NEW] Temporal
  abolishedOn         DateTime?     // [NEW] Temporal
  appointedBy         String?
  removableBy         String?
  reportsTo           String?
  positions           Position[]
  roles               PersonRole[]  // [NEW] Temporal Link
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([branch, level])
  @@index([slug])
  @@index([parentId])
}

model Position {
  id                   String       @id @default(cuid())
  title                String
  institutionId        String
  institution          Institution  @relation(fields: [institutionId], references: [id])
  constitutionalBasis  String?
  appointedBy          String?
  removableBy          String?
  tenure               String?
  powers               String[]
  currentHolderId      String?      @unique
  currentHolder        Person?      @relation("CurrentPosition", fields: [currentHolderId], references: [id])
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([institutionId])
}

// ─── PEOPLE & TEMPORAL ROLES ─────────────────────────────────

model Person {
  id              String               @id @default(cuid())
  name            String
  designation     String?
  dateOfBirth     DateTime?
  gender          String?
  education       String?
  photoUrl        String?
  thumbnailUrl    String?
  mediaVerified   Boolean              @default(false)
  mediaUpdatedAt  DateTime?
  currentPosition Position?            @relation("CurrentPosition")
  partyId         String?
  party           PoliticalParty?      @relation(fields: [partyId], references: [id])
  partyHistory    PersonPartyHistory[] // [NEW] Temporal Link
  roles           PersonRole[]         // [NEW] Temporal Link
  stateCode       String?
  state           String?
  constituency    String?
  chamber         String?
  level           String?
  contact         Json?
  profile         Json?
  socialLinks     Json?                // [NEW] Facebook, Twitter, Instagram, Website
  assets          Json?                // [NEW] Declared assets, liabilities
  criminalCases   Json?                // [NEW] Declared criminal cases
  electionResults ElectionResult[]     @relation("ElectionWinner")
  elections       ElectionCandidate[]  // [NEW] Candidate Link
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([stateCode, chamber])
  @@index([partyId])
}

model PersonPartyHistory {
  id        String         @id @default(cuid())
  personId  String
  person    Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  partyId   String
  party     PoliticalParty @relation(fields: [partyId], references: [id], onDelete: Restrict)
  validFrom DateTime
  validTo   DateTime?

  @@index([personId])
  @@index([partyId])
  @@index([personId, validFrom, validTo])
}

model PersonRole {
  id            String       @id @default(cuid())
  personId      String
  person        Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  title         String
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  committeeId   String?
  committee     Committee?   @relation(fields: [committeeId], references: [id], onDelete: SetNull)
  validFrom     DateTime
  validTo       DateTime?

  @@index([personId])
  @@index([validFrom, validTo])
  @@index([personId, validFrom, validTo])
  @@index([institutionId])
  @@index([committeeId])
}

// ─── POLITICAL PARTIES ───────────────────────────────────────

model PoliticalParty {
  id           String               @id @default(cuid())
  name         String               @unique
  abbreviation String               @unique
  founded      Int?
  foundedOn    DateTime?            // [NEW] Temporal
  disbandedOn  DateTime?            // [NEW] Temporal
  ideology     String[]
  president    String?
  headquarters String?
  color        String
  type         String
  symbol       String?
  logoUrl      String?
  bannerUrl    String?
  mediaUpdatedAt DateTime?
  website      String?
  members      Person[]
  memberships  PersonPartyHistory[] // [NEW] Temporal Link
  alliances    String[]
  currentSeats Json?
  history      String?
  states       String[]
  candidates   ElectionCandidate[]  // [NEW] Candidate Link
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

// ─── ELECTIONS & GEOGRAPHY ───────────────────────────────────

model StateUT {
  id             String         @id @default(cuid())
  name           String         @unique
  code           String         @unique
  type           String
  capital        String
  lsSeats        Int
  rsSeats        Int
  assemblySeats  Int
  reservedSC     Int            @default(0)
  reservedST     Int            @default(0)
  formedOn       DateTime?      // [NEW] Temporal
  abolishedOn    DateTime?      // [NEW] Temporal
  districts      District[]     // [NEW] Relation
  constituencies Constituency[] // [NEW] Relation
  createdAt      DateTime       @default(now())
}

model District {
  id          String    @id @default(cuid())
  name        String
  stateId     String
  state       StateUT   @relation(fields: [stateId], references: [id])
  formedOn    DateTime? // [NEW] Temporal
  abolishedOn DateTime? // [NEW] Temporal
  // geom     Unsupported("geometry")? // PostGIS — enable in prod with postgis/postgis image
  pinCodes    PinCode[]
  createdAt   DateTime  @default(now())

  @@index([stateId])
}

model Constituency {
  id              String              @id @default(cuid())
  name            String
  number          Int?
  type            String
  stateCode       String
  state           StateUT?            @relation(fields: [stateCode], references: [code]) // [NEW] Relation
  reservedFor     String?
  totalVoters     Int?
  delimitation    Int?                // [NEW] Temporal
  validFrom       DateTime?           // [NEW] Temporal
  validTo         DateTime?           // [NEW] Temporal
  // geom         Unsupported("geometry")? // PostGIS — enable in prod with postgis/postgis image
  pinCodes        PinCode[]
  electionResults ElectionResult[]
  elections       ElectionCandidate[] // [NEW] Candidate Link
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([name, stateCode, type])
  @@index([stateCode, type])
}

// Legacy Election model (Preserved for compatibility)
model ElectionResult {
  id             String       @id @default(cuid())
  year           Int
  type           String
  constituencyId String
  constituency   Constituency @relation(fields: [constituencyId], references: [id])
  winnerId       String
  winner         Person       @relation("ElectionWinner", fields: [winnerId], references: [id])
  winnerParty    String
  winnerVotes    Int
  runnerUpName   String?
  runnerUpParty  String?
  runnerUpVotes  Int?
  totalVoters    Int?
  votesPolled    Int?
  turnout        Float?
  margin         Int?
  createdAt      DateTime     @default(now())

  @@index([year, type])
  @@index([constituencyId])
  @@index([winnerId])
}

// Legacy Summary model
model ElectionSummary {
  id          String   @id @default(cuid())
  year        Int
  type        String
  totalSeats  Int
  majorWinner String
  majorSeats  Int
  turnout     Float?
  createdAt   DateTime @default(now())

  @@unique([year, type])
}

// Legacy Party model
model PartyElectionResult {
  id        String   @id @default(cuid())
  year      Int
  type      String
  party     String
  color     String
  seats     Int
  voteShare Float?
  createdAt DateTime @default(now())

  @@unique([year, type, party])
  @@index([year, type])
}

// State-wise election results per year
model StateElectionResult {
  id          String  @id @default(cuid())
  year        Int
  type        String  // "lok_sabha" | "assembly"
  state       String
  code        String
  seats       Int
  dominant    String
  dominantColor String
  dominantSeats Int
  alliance    String  // "NDA" | "INDIA" | "Other"
  turnout     Float
  ndaSeats    Int     @default(0)
  indiaSeats  Int     @default(0)
  otherSeats  Int     @default(0)

  @@unique([year, type, state])
  @@index([year, type])
}

// State assembly election results
model StateAssemblyElection {
  id            String @id @default(cuid())
  state         String
  year          Int
  totalSeats    Int
  winner        String
  winnerColor   String
  winnerSeats   Int
  runnerUp      String
  runnerUpSeats Int
  turnout       Float

  @@unique([state, year])
  @@index([year])
}

// [NEW] PIN Code Mapping
model PinCode {
  id             String       @id @default(cuid())
  code           String       @unique
  districtId     String?
  district       District?    @relation(fields: [districtId], references: [id])
  constituencyId String?
  constituency   Constituency? @relation(fields: [constituencyId], references: [id])
  
  @@index([code])
}

// [NEW] Comprehensive Election Models
model Election {
  id         String              @id @default(cuid())
  year       Int
  type       String
  startDate  DateTime?
  endDate    DateTime?
  totalSeats Int
  turnout    Float?
  candidates ElectionCandidate[]

  @@unique([year, type])
}

model ElectionCandidate {
  id             String         @id @default(cuid())
  electionId     String
  election       Election       @relation(fields: [electionId], references: [id], onDelete: Restrict)
  constituencyId String
  constituency   Constituency   @relation(fields: [constituencyId], references: [id], onDelete: Restrict)
  personId       String
  person         Person         @relation(fields: [personId], references: [id], onDelete: Restrict)
  partyId        String
  party          PoliticalParty @relation(fields: [partyId], references: [id], onDelete: Restrict)
  votes          Int
  isWinner       Boolean        @default(false)

  @@index([electionId])
  @@index([constituencyId])
  @@index([personId])
  @@index([partyId])
}

// ─── JUDICIARY ───────────────────────────────────────────────

model Court {
  id             String         @id @default(cuid())
  name           String         @unique
  type           String
  jurisdiction   String?
  stateCode      String?
  established    Int?
  establishedOn  DateTime?
  judges         String?
  basis          String?
  description    String?
  powers         String[]
  logoUrl        String?
  mediaUpdatedAt DateTime?
  // Hierarchy fields
  courtCount     String?        // "1", "25", etc.
  courtChildren  String[]       // slugs of child court types
  // High court specific
  city           String?
  states         String[]
  region         String?
  benches        String[]
  sanctioned     Int?
  notable        String?
  cases          LandmarkCase[]
  createdAt      DateTime       @default(now())
}

model LandmarkCase {
  id                  String                @id @default(cuid())
  name                String
  citation            String?
  year                Int
  dateDecided         DateTime?             // [NEW] Temporal
  courtId             String
  court               Court                 @relation(fields: [courtId], references: [id], onDelete: Restrict)
  summary             String
  significance        String
  impact              String?
  articlesInterpreted ConstitutionArticle[] @relation("ArticleCases")
  createdAt           DateTime              @default(now())

  @@index([courtId])
  @@index([year])
}

// ─── LEGISLATION ─────────────────────────────────────────────

model Bill {
  id           String    @id @default(cuid())
  title        String
  type         String
  introducedIn String
  introducedBy String?
  introducedOn DateTime?
  status       String
  summary      String?
  fullTextUrl  String?
  ministry     String?
  actId        String?   @unique // [NEW] Relation
  act          Act?      @relation(fields: [actId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, type])
}

model Act {
  id        String   @id @default(cuid())
  title     String
  year      Int
  enactedOn DateTime
  bill      Bill?
  createdAt DateTime @default(now())
}

// ─── MINISTRIES, COMMITTEES & BUREAUCRACY ────────────────────

model Ministry {
  id            String       @id @default(cuid())
  name          String       @unique
  department    String       // Legacy string
  departments   Department[] // [NEW] Relation
  logoUrl       String?
  mediaUpdatedAt DateTime?
  establishedOn DateTime?    // [NEW] Temporal
  abolishedOn   DateTime?    // [NEW] Temporal
  createdAt     DateTime     @default(now())
}

model Department {
  id         String   @id @default(cuid())
  name       String
  ministryId String
  ministry   Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([ministryId])
}

model Committee {
  id          String       @id @default(cuid())
  name        String
  type        String
  formedOn    DateTime
  dissolvedOn DateTime?
  members     PersonRole[]
  createdAt   DateTime     @default(now())
}

model BureaucraticLevel {
  id          String   @id @default(cuid())
  hierarchy   String
  level       Int
  title       String
  description String
  createdAt   DateTime @default(now())

  @@unique([hierarchy, level])
  @@index([hierarchy])
}

// ─── GOVERNANCE PROCESSES ────────────────────────────────────

model GovernanceProcess {
  id                  String        @id @default(cuid())
  slug                String        @unique
  name                String        @unique
  description         String
  category            String
  difficulty          String        @default("beginner")
  estimatedTime       String?
  constitutionalBasis String?
  steps               ProcessStep[]
  createdAt           DateTime      @default(now())
}

model ProcessStep {
  id                    String            @id @default(cuid())
  processId             String
  process               GovernanceProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  order                 Int
  title                 String
  description           String
  actor                 String
  institution           String            @default("")
  constitutionalArticle String?
  duration              String?
  isOptional            Boolean           @default(false)
  outcomes              String[]
  fact                  String?
  options               Json?
}

// ─── TIMELINE ────────────────────────────────────────────────

model TimelineEvent {
  id           String   @id @default(cuid())
  date         DateTime
  displayDate  String
  title        String
  description  String
  category     String
  significance String
  relatedData  Json?
  createdAt    DateTime @default(now())

  @@index([category, date])
}

// ─── LEARNING ────────────────────────────────────────────────

model LearningPath {
  id             String           @id @default(cuid())
  slug           String           @unique
  title          String           @unique
  description    String
  level          String
  estimatedHours Float
  color          String           @default("slate")
  prerequisites  String[]
  modules        LearningModule[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model LearningModule {
  id               String       @id @default(cuid())
  pathId           String
  path             LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  title            String
  description      String       @default("")
  type             String       @default("explainer")
  content          String       @default("")
  estimatedMinutes Int          @default(30)
  order            Int
  createdAt        DateTime     @default(now())
}

// ─── CITIZEN ACTION ──────────────────────────────────────────

model CitizenAction {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  icon        String
  difficulty  String
  cost        String
  timeline    String
  legalBasis  String
  template    String?
  steps       String[]
  createdAt   DateTime @default(now())
}

// ─── WRITS ───────────────────────────────────────────────────

model Writ {
  id      String @id @default(cuid())
  name    String @unique
  meaning String
  usage   String
}

// ─── CIVIL SERVICES ─────────────────────────────────────────

model CivilService {
  id          String @id @default(cuid())
  name        String @unique
  description String
  exam        String
  cadre       String
}

// ─── IDEOLOGY SPECTRUM ───────────────────────────────────────

model IdeologyPosition {
  id          String   @id @default(cuid())
  position    String   @unique
  parties     String[]
  description String
  order       Int      @default(0)
}

// ─── OBSERVABILITY ───────────────────────────────────────────

model ScraperRun {
  id               String    @id @default(cuid())
  source           String    // "ADR_MYNETA" | "ECI_PORTAL" | "PRS_INDIA" | "SUPREME_COURT" | "INDIA_CODE_API" | "IMAGE_INGEST"
  jobId            String?
  status           String    // "running" | "success" | "failed" | "timeout"
  startedAt        DateTime
  finishedAt       DateTime?
  durationMs       Int?
  recordsProcessed Int       @default(0)
  recordsFailed    Int       @default(0)
  errorMessage     String?
  errorStack       String?
  httpStatus       Int?
  retryCount       Int       @default(0)

  @@index([source, startedAt])
  @@index([status, startedAt])
}

model ObservabilityLog {
  id         String   @id @default(cuid())
  level      String   // "debug" | "info" | "warn" | "error"
  source     String   // e.g., "ETL:ADR", "QUEUE:api-fetch"
  message    String
  context    Json?
  traceId    String?
  jobId      String?
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([level, createdAt])
  @@index([source, createdAt])
  @@index([traceId])
}

model AlertEvent {
  id         String    @id @default(cuid())
  rule       String
  severity   String    // "critical" | "warning" | "info"
  message    String
  context    Json?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([rule, createdAt])
  @@index([severity, resolvedAt])
}
